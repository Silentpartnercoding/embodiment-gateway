{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Silentpartnercoding/embodiment-gateway/contracts/root-judgment.v1.schema.json",
  "title": "Embodiment Gateway root judgment v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "subject_id", "issuer", "verdict", "support_roots",
    "challenge_roots", "flip_budget", "conflicting_roots",
    "unattributed_claims", "issued_at"
  ],
  "properties": {
    "schema": {"const": "embodiment-gateway.root-judgment.v1"},
    "subject_id": {"type": "string", "minLength": 1},
    "issuer": {"type": "string", "minLength": 1},
    "verdict": {"enum": ["true", "false", "abstain"]},
    "support_roots": {"$ref": "#/$defs/roots"},
    "challenge_roots": {"$ref": "#/$defs/roots"},
    "flip_budget": {"type": "integer", "minimum": 0},
    "conflicting_roots": {"$ref": "#/$defs/roots"},
    "unattributed_claims": {"type": "integer", "minimum": 0},
    "issued_at": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "roots": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
